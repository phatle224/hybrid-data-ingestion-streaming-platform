{
  "name": "mysql-source-connector",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "tasks.max": "1",
    "database.hostname": "localhost",
    "database.port": "3306",
    "database.user": "synthetic_db_user",
    "database.password": "REDACTED_PASSWORD",
    "database.server.id": "184054",
    "topic.prefix": "source", 
    "database.include.list": "insuranceSale",
    "table.include.list": "insuranceSale.contract,insuranceSale.contractObject,insuranceSale.contractObjectVehicle,insuranceSale.contractObjectTravel,insuranceSale.contractObjectMoto,insuranceSale.contractObjectSocialInsurance,insuranceSale.contractObjectmedicalInsurance,insuranceSale.contractObjectHouse,insuranceSale.claim",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:9093",
    "schema.history.internal.kafka.topic": "schema-changes.source.insuranceSale",
    "include.schema.changes": "false",
    "tombstones.on.delete": "false",
    "snapshot.mode": "when_needed",
    "provide.transaction.metadata": "true",
    "time.precision.mode": "connect",
    "decimal.handling.mode": "string",
    "schema.history.internal.store.only.captured.tables.ddl": "true",
    "schema.history.internal.skip.unparseable.ddl": "true",
    "inconsistent.schema.handling.mode": "warn",
    "event.processing.failure.handling.mode": "skip",
    "errors.tolerance": "none",
    "errors.deadletterqueue.topic.name": "dlq.source.insuranceSale",
    "errors.deadletterqueue.topic.replication.factor": "1",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true",
    "heartbeat.interval.ms": "10000"
  }
}
